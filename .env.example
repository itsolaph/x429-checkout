# x429 Checkout configuration. Server: copy to an env file outside git (.env.local and .env.production
# are gitignored; on a server e.g. /etc/x429/server.env, chmod 600) and start with
# `bash scripts/start-server.sh <env-file>` (systemd: deploy/x429-checkout.service).
# Machine-specific values (RPC URLs with keys, key file paths, public URL) belong only in that file.

# Chain
X429_RPC_URL=http://127.0.0.1:8545          # Base RPC (or a local anvil fork of Base)
X429_CHAIN_ID=8453                          # Base mainnet
X429_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X429_EXPLORER=https://basescan.org

# Contract (printed by `bash scripts/deploy-base.sh <deploy-env-file> --broadcast`)
X429_CONTRACT=0x0000000000000000000000000000000000000000
X429_QUEUE_ID=1
X429_DEPLOY_BLOCK=0                         # first block the dashboard feed indexes

# Operator wallet: settles paid joins and skips, serves the head and pushes payouts. Needs ETH on Base
# for gas, never USDC. Use a file outside the repo (chmod 600). Without it the server is read-only.
X429_OPERATOR_KEY_FILE=/path/outside/the/repo/operator.key

# HTTP
X429_HOST=127.0.0.1
X429_PORT=8429
X429_PUBLIC_URL=http://127.0.0.1:8429       # public origin (https in production): x402 `resource` URLs
# X429_ALLOW_HTTP=1                         # start-server.sh: allow a non-https public URL (tests only)
X429_SITE_DIR=site                          # serve the built dashboard at /

# Queue behaviour
X429_SERVICE_INTERVAL_MS=15000              # the busy API admits one request per interval
X429_MIN_QUEUE_MS=15000                     # admission round: the head waits at least this long
X429_ADMISSION_TTL_MS=300000                # a served ticket must use its request within this window
X429_SUGGESTED_SKIP_PRICE=0.005             # USDC; default skip price for new tickets
X429_MAX_SKIP_PRICE=0.1                     # USDC; highest skip price a join or skip may post
X429_SLIPPAGE_BPS=2000                      # 402 ceiling = quoted cost + 20%
X429_PAYMENT_TIMEOUT_S=120                  # x402 maxTimeoutSeconds
X429_QUOTE_TTL_S=600                        # how long a quote's ceiling is honoured (v2 echo)
X429_POLL_MS=1000
X429_LOG=json                               # json | text

# Redeem tokens and automatic payouts
X429_DATA_DIR=/var/lib/x429                 # hashed redeem tokens survive restarts here (unset: memory)
X429_AUTO_PAYOUT=1                          # operator pushes compensation to passed owners (0: owners claim)
X429_PAYOUT_INTERVAL_MS=3000                # retry / batching tick for payouts
X429_DEMO_AGENTS=                           # comma-separated addresses of the operator's demo agents

# Deploy (scripts/deploy-base.sh reads these from its own env file, outside the repo, chmod 600)
# OPERATOR_PRIVATE_KEY=0x…                  # never commit; also the deployer unless DEPLOYER_PRIVATE_KEY
# BASE_RPC_URL=https://…
# QUEUE_FEE_BPS=0
# QUEUE_JOIN_FEE=1000                       # 0.001 USDC per paid join (goes to the operator's fees)
# QUEUE_MAX_LENGTH=64
# QUEUE_META={"name":"x429 forecast API","path":"/v1/forecast"}
# BASESCAN_API_KEY=…                        # optional source verification

# PayBox plugin (portal: Variables & Secrets → Environment variable; no secrets needed)
# X429_API_BASE=https://<your x429 host>     # the same origin as X429_PUBLIC_URL; network host = its hostname
# X429_PROPOSAL_ORIGIN=https://…            # local tests only, with an http://127.0.0.1 X429_API_BASE

# scripts/e2e-local.sh and scripts/mcp-smoke.sh
# E2E_RPC_URL=https://mainnet.base.org       # fork source (read only)
# E2E_FORK_BLOCK=52621900
# E2E_KEEP=1                                 # leave anvil + server running to look at the dashboard
