# x429 Checkout server configuration. Copy to .env.local (gitignored) and load it before
# `npm run server`, e.g. `set -a; . ./.env.local; set +a; npm run server`.
# Machine-specific values (RPC URLs with keys, key file paths, public URL) belong only in .env.local.

# Chain
X429_RPC_URL=http://127.0.0.1:8545          # Base RPC (or a local anvil fork of Base)
X429_CHAIN_ID=8453                          # Base mainnet
X429_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X429_EXPLORER=https://basescan.org

# Contract (from `forge script contracts/script/Deploy.s.sol:Deploy`)
X429_CONTRACT=0x0000000000000000000000000000000000000000
X429_QUEUE_ID=1
X429_DEPLOY_BLOCK=0                         # first block the dashboard feed indexes

# Operator wallet: relays joins, claims and skips, and serves the head. Needs ETH on Base for gas,
# never USDC. Use a file outside the repo (chmod 600). Without it the server is read-only.
X429_OPERATOR_KEY_FILE=/path/outside/the/repo/operator.key

# HTTP
X429_HOST=127.0.0.1
X429_PORT=8429
X429_PUBLIC_URL=http://127.0.0.1:8429       # what goes into x402 `resource` URLs
X429_SITE_DIR=site                          # serve the built dashboard at /

# Queue behaviour
X429_SERVICE_INTERVAL_MS=15000              # the busy API admits one request per interval
X429_MIN_QUEUE_MS=15000                     # admission round: the head waits at least this long
X429_ADMISSION_TTL_MS=60000                 # a served ticket must redeem within this window
X429_SUGGESTED_SKIP_PRICE=0.005             # USDC; default skip price for new tickets
X429_SLIPPAGE_BPS=2000                      # 402 ceiling = quoted cost + 20%
X429_PAYMENT_TIMEOUT_S=120                  # x402 maxTimeoutSeconds
X429_QUOTE_TTL_S=600                        # how long a quote's ceiling is honoured (v2 echo)
X429_POLL_MS=1000
X429_LOG=json                               # json | text

# scripts/e2e-local.sh and scripts/mcp-smoke.sh
# E2E_RPC_URL=https://mainnet.base.org       # fork source (read only)
# E2E_FORK_BLOCK=52621900
# E2E_KEEP=1                                 # leave anvil + server running to look at the dashboard
