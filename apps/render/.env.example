# render.x429.lol configuration. Copy to ~/.x429-render/render.env (chmod 600) and fill in the X429_*
# values from `x429 deploy` and `x429 queue create` (see deploy/DEPLOY.md). No secret goes in this
# file: the operator key lives in its own file, named by X429_OPERATOR_KEY_FILE.

# --- HTTP ---
RENDER_HOST=127.0.0.1
RENDER_PORT=8440
# behind Caddy (which overwrites X-Forwarded-For): the client address is its last entry
RENDER_TRUST_PROXY=1

# --- Chromium ---
# paths below: replace YOU with the user that runs the service
# the build playwright-core 1.64.1 expects (chromium-1248); `npx playwright-core install chromium` puts it there
RENDER_CHROMIUM_PATH=/home/YOU/.cache/ms-playwright/chromium-1248/chrome-linux64/chrome
# Chromium's own sandbox needs unprivileged user namespaces (or the setuid chrome_sandbox); 0 runs without it
RENDER_CHROMIUM_SANDBOX=0

# --- capacity and limits (defaults shown) ---
RENDER_CONCURRENCY=2
RENDER_FREE_PER_HOUR=30
RENDER_TIMEOUT_MS=20000
RENDER_MAX_BYTES=5242880
RENDER_MAX_REDIRECTS=2
RENDER_MAX_REQUESTS=300
RENDER_BLOCK_MEDIA=1
RENDER_ALLOW_POST=0
RENDER_MARKDOWN_MAX_BYTES=204800
RENDER_PNG_MAX_HEIGHT=8000
RENDER_ROBOTS_TTL_MS=600000

# --- the x429 lane (the same names as x429.lol) ---
X429_PUBLIC_URL=https://render.x429.lol
X429_RPC_URL=https://mainnet.base.org
X429_CHAIN_ID=8453
X429_CONTRACT=0x...
X429_QUEUE_ID=1
X429_DEPLOY_BLOCK=0
X429_OPERATOR_KEY_FILE=/home/YOU/.x429-render/operator.key
X429_DATA_DIR=/home/YOU/.x429-render/data
# getLogs RPCs for the event feed, rotated on errors (comma separated; default: X429_RPC_URL)
X429_LOGS_RPC_URLS=https://base-rpc.publicnode.com,https://base.drpc.org
X429_PREFIX=/x429

# prices in USDC: a new ticket's skip price (what anyone who passes it pays it) and the most it may post
X429_SUGGESTED_SKIP_PRICE=0.01
X429_MAX_SKIP_PRICE=0.05
# how long a served ticket may take to use its render; the first per-render estimate for ETAs
X429_ADMISSION_TTL_MS=120000
X429_ESTIMATE_MS=4000
X429_ADMISSION_ROUND_MS=0
X429_SERVE_CONFIRM=1
X429_POLL_MS=1000
X429_PAYOUT_INTERVAL_MS=3000
